# Copy to .env and supply an API key. Do not commit credentials.
MISTRAL_API_KEY=replace_me
# Prefer release IDs over mutable aliases. Verify model access with your organization.
MISTRAL_OCR_MODEL=mistral-ocr-4-1
# Primary topic classifier and QA both use Mistral Small.
MISTRAL_TOPIC_MODEL=mistral-small-2603
MISTRAL_TOPIC_REFINEMENT_MODEL=mistral-large-4
MISTRAL_CHAT_MODEL=mistral-small-2603
MISTRAL_JUDGE_MODEL=mistral-large-latest

# Benchmark-only oracle experiment. Set false to restore Small-only topic results.
TOPIC_RUNNER_UP_LARGE_EXPERIMENT=true
# Optional embedding candidate router. Use `off` to restore the original topic path,
# `shadow` to measure top-3 recall without changing the prompt, or `advisory` to
# supply the top three candidates to Mistral Small as non-binding hints.
MISTRAL_EMBEDDING_MODEL=mistral-embed
TOPIC_EMBEDDING_MODE=off
TOPIC_EMBEDDING_TOP_K=3
TOPIC_EMBEDDING_MAX_CHARS=12000
# Hugging Face access token used for RepLiQA metadata and PDF downloads.
# Create a read token at https://huggingface.co/settings/tokens and never commit it.
HF_TOKEN=hf_replace_me
# Optionally pin to the exact ServiceNow/repliqa Git commit for reproducibility.
HF_DATASET_REVISION=main
# Public list-price assumptions verified 2026-11-03, USD. Recheck before panel.
PRICE_AS_OF=2026-11-03
OCR_USD_PER_1000_PAGES=4
TOPIC_INPUT_USD_PER_M_TOKENS=0.15
TOPIC_OUTPUT_USD_PER_M_TOKENS=0.60
CHAT_INPUT_USD_PER_M_TOKENS=0.15
CHAT_OUTPUT_USD_PER_M_TOKENS=0.60
JUDGE_INPUT_USD_PER_M_TOKENS=0.50
JUDGE_OUTPUT_USD_PER_M_TOKENS=1.50
EMBEDDING_USD_PER_M_TOKENS=0.10
INCUMBENT_USD_PER_PAGE=0.75
MAX_DOCUMENT_CHARS=90000
